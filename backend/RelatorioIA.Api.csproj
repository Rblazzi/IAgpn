<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    API do chat de relatórios (sistema à parte, publicado como um site próprio).
    Publicar:  dotnet publish RelatorioIA.Api.csproj -c Release -o <pasta-do-site>
    O código fica no projeto AssistenteRelatorios/ (referenciado abaixo).
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- A pasta do módulo tem projeto próprio: não compilar os arquivos dela aqui também -->
    <Compile Remove="AssistenteRelatorios\**" />
    <Content Remove="AssistenteRelatorios\**" />
    <None Remove="AssistenteRelatorios\**" />
    <EmbeddedResource Remove="AssistenteRelatorios\**" />
    <ProjectReference Include="AssistenteRelatorios\AssistenteRelatorios.csproj" />
  </ItemGroup>

</Project>
